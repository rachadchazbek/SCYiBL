# Copy to .env and fill in. .env is git-ignored and blocked by pre-commit.
# Only the variables required by config/agents.yaml must be set;
# run `uv run scyibl config check` to see which ones.

# LLM provider(s)
COHERE_API_KEY=

# Private dataset (issue #16)
HF_TOKEN=

# Safety alerts (issue #8), only when alerts.email.enabled / alerts.google_sheet.enabled
ALERT_EMAIL_TO=
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: use another config file
# SCYIBL_CONFIG=config/agents.yaml
